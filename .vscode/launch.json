{
    "version": "0.2.0",
    "configurations": [
        {
            // Fixed path: F5 works without picking a CMake launch target first.
            "name": "Debug tofu-plugin-cpp",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/terraform-provider-workaround",
            // --debug: the provider refuses to start by hand without OpenTofu's magic cookie.
            "args": ["--debug"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ],
            "preLaunchTask": "CMake: build"
        },
        {
            "name": "Debug (CMake Tools target)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": ["--debug"],
            "stopAtEntry": false,
            "cwd": "${command:cmake.launchTargetDirectory}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ],
            "preLaunchTask": "CMake: build"
        }
    ]
}
