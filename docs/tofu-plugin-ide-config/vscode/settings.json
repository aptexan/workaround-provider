{
    "cmake.sourceDirectory": "${workspaceFolder}",
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.configureOnOpen": true,
    "cmake.generator": "Unix Makefiles",

    // Same file works on WSL and on native Debian/Linux: nothing here is
    // machine- or user-specific. gRPC/protobuf/abseil are expected in ~/.local/grpc.
    // /mnt/c only exists under WSL (Windows anaconda copies leak in through PATH);
    // on native Linux the path does not exist, so ignoring it is harmless.
    "cmake.configureSettings": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_PREFIX_PATH": "${userHome}/.local/grpc",
        "CMAKE_IGNORE_PREFIX_PATH": "/mnt/c"
    },

    // IntelliSense: clangd reads build/compile_commands.json (includes -std=c++23
    // and the generated *.pb.h path); the Microsoft engine is off so they don't fight.
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.autocomplete": "disabled",
    "C_Cpp.errorSquiggles": "disabled",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build",
        "--background-index",
        "--header-insertion=iwyu"
    ]
}
